---
import '../styles/global.css';

interface Props {
  title?: string;
  /** Hides the header for full-bleed surfaces such as the player. */
  bare?: boolean;
}

const { title = 'Online Gal', bare = false } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content="浏览器环境的线上多引擎视觉小说模拟器：KiriKiri/KAG3、ONScripter、TyranoBuilder 与 HTML5 游戏。"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    {
      !bare && (
        <header class="site-header">
          <div class="site-header__inner">
            <a class="brand" href="/">
              <span class="brand__mark" aria-hidden="true">OG</span>
              <span class="brand__text">
                <strong>Online Gal</strong>
                <small>线上视觉小说模拟器</small>
              </span>
            </a>
            <nav class="site-nav" aria-label="主导航">
              <a href="/" class:list={['site-nav__link', { 'is-active': path === '/' }]}>
                游戏库
              </a>
              <a
                href="/settings"
                class:list={['site-nav__link', { 'is-active': path.startsWith('/settings') }]}
              >
                设置
              </a>
              <a
                href="/engines"
                class:list={['site-nav__link', { 'is-active': path.startsWith('/engines') }]}
              >
                引擎
              </a>
            </nav>
          </div>
        </header>
      )
    }
    <main class:list={['site-main', { 'site-main--bare': bare }]}>
      <slot />
    </main>
    <footer class:list={['site-footer', { 'site-footer--hidden': bare }]}>
      <p>
        引擎运行于浏览器本地，游戏文件不会上传。基于
        <a href="https://github.com/AetherKiri/AetherKiri" rel="noreferrer noopener" target="_blank"
          >AetherKiri</a
        >
        的多运行时调度与
        <a
          href="https://github.com/Weiss-UltimateSavior/Tyranor-Next"
          rel="noreferrer noopener"
          target="_blank">Tyranor-Next</a
        >
        的引擎识别表构建。
      </p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--header-height);
    background: rgba(10, 12, 17, 0.82);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .site-header__inner {
    max-width: var(--content-max);
    height: 100%;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: linear-gradient(140deg, var(--accent), #7d5bef);
    color: #05101f;
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand__text small {
    color: var(--text-dim);
    font-size: 0.72rem;
  }

  .site-nav {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }

  .site-nav__link {
    padding: 7px 14px;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.92rem;
    transition: background 0.14s ease, color 0.14s ease;
  }

  .site-nav__link:hover {
    background: var(--bg-hover);
    color: var(--text);
    text-decoration: none;
  }

  .site-nav__link.is-active {
    background: var(--accent-soft);
    color: var(--accent-text);
  }

  .site-main {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 28px 24px 64px;
  }

  .site-main--bare {
    max-width: none;
    padding: 0;
  }

  .site-footer {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.82rem;
  }

  .site-footer--hidden {
    display: none;
  }

  @media (max-width: 640px) {
    .site-header__inner {
      padding: 0 14px;
      gap: 12px;
    }

    .brand__text small {
      display: none;
    }

    .site-main {
      padding: 20px 14px 48px;
    }
  }
</style>
