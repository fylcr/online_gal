---
/**
 * Site shell: header, nav and footer are static HTML; only `#swup` is swapped
 * on navigation. The player page uses `bare` and is excluded from swup (see
 * `src/lib/swup.ts`), so leaving or entering it is always a full page load.
 */
import '../styles/global.css';
import Dock from '../components/Dock.astro';

interface Crumb {
  label: string;
  /** Omitted on the last crumb (the current page). */
  href?: string;
}

interface Props {
  /** Document title. */
  title: string;
  /** Header heading; defaults to `title`. */
  heading?: string;
  /**
   * Breadcrumbs, shown only when given (settings sub-pages). `root` is the
   * page the leading `>` links to; `trail` is the levels below it, current last.
   */
  breadcrumbs?: { root: string; trail: Crumb[] };
  /** Player page: no header/footer, full-viewport content. */
  bare?: boolean;
}

const { title, bare = false, breadcrumbs } = Astro.props;
const heading = Astro.props.heading ?? title;
---

<!doctype html>
<html lang="zh-CN" data-theme="swiss" class:list={[!bare && 'site-shell']}>
  <head>
    <meta charset="utf-8" />
    {/* viewport-fit=cover makes env(safe-area-inset-*) report the notch / home bar (portrait dock). */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/webp" href="/logo.webp" />
    <title>{title} · online_gal</title>
  </head>
  <body class="min-h-screen bg-base-100 font-sans text-base-content antialiased">
    {
      bare ? (
        <slot />
      ) : (
        <div class="flex min-h-screen flex-col">
          {/*
            Desktop vs mobile is decided by aspect ratio, not width: `landscape:` (width > height)
            is desktop, `portrait:` (height ≥ width) is mobile.
            Landscape grid: outer margin 24px (px-6). Column 1 = logo / dock, 48px wide.
            Gutter 48px. Column 2 starts at 120px (landscape:pl-30): page title, content, footer.
            Portrait: single column at px-6; the dock floats at the bottom, so the page reserves
            room below the footer (dock 48px + 24px offset + 24px gap + safe area).
          */}
          <header data-site-header class="fixed inset-x-0 top-0 z-30 border-b border-base-300 bg-base-100 pt-[var(--site-safe-top)]">

            <div class="site-inline flex h-[var(--site-header-row)] items-center">
              <a href="/" class="site-logo flex shrink-0 items-center" aria-label="online_gal 首页">
                {/* Original 1254×1254 file from public/, served as-is: astro:assets resizing to 48/96px re-encoded it and blurred it. */}
                <img src="/logo.webp" alt="" width="48" height="48" class="size-10 sm:size-12" loading="eager" decoding="async" />
              </a>
              <h1 id="page-title" class="transition-fade site-title min-w-0 wrap-anywhere text-lg leading-tight font-bold sm:text-2xl">
                {heading}
              </h1>
              <div class="site-actions flex flex-none items-center" role="group" aria-label="操作">
                <button type="button" data-open-modal="site-search" aria-label="搜索游戏" class="btn btn-ghost btn-circle" title="搜索游戏">
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </button>
                <div class="dropdown dropdown-end">
                  <div tabindex="0" role="button" aria-label="打开导航菜单" class="btn btn-ghost btn-circle" title="打开导航菜单">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                  </div>
                  {/* Placeholder: the menu content is redesigned later. */}
                  <div tabindex="-1" data-site-menu aria-label="导航菜单" class="dropdown-content z-40 mt-3 w-52 bg-base-100 p-4 text-sm text-base-content/70 shadow">
                    菜单待重新设计
                  </div>
                </div>
              </div>
            </div>
          </header>

          {/*
            Breadcrumbs under the header, on column 2, path-style: `>` is the section root and
            `/` precedes every level, spaced by gap-x-2 (`> / 音频`, `> / 音频 / 子项`). Swup container, fades with the content. The element is always
            rendered (swup needs every container on both sides of a visit) and empty when the
            page has no breadcrumbs.
          */}
          <div id="breadcrumbs" class="site-content transition-fade pt-[var(--site-header-height)] text-sm">
            {breadcrumbs && (
              <nav aria-label="面包屑">
                <ol class="flex flex-wrap items-center gap-x-2 text-base-content/40">
                  <li>
                    {breadcrumbs.trail.length === 0 ? (
                      <span aria-current="page" class="text-base-content">&gt;</span>
                    ) : (
                      <a href={breadcrumbs.root} aria-label={heading} class="hover:text-base-content">&gt;</a>
                    )}
                  </li>
                  {breadcrumbs.trail.map((crumb, i) => (
                    <li class="flex items-center gap-x-2">
                      <span aria-hidden="true">/</span>
                      {i < breadcrumbs.trail.length - 1 && crumb.href ? (
                        <a href={crumb.href} class="hover:text-base-content">{crumb.label}</a>
                      ) : (
                        <span aria-current="page" class="text-base-content">{crumb.label}</span>
                      )}
                    </li>
                  ))}
                </ol>
              </nav>
            )}
          </div>

          <Dock />

          <main id="swup" class="site-content transition-fade w-full flex-1 pt-6 pb-[var(--site-content-end)]">
            <slot />
          </main>

          <footer data-site-footer class="fixed inset-x-0 bottom-0 z-10 bg-base-100 pb-[var(--site-safe-bottom)]">
            <div class="site-footer-text flex h-[var(--site-footer-row)] items-center border-t border-base-300 text-xs text-base-content/60">
              GPL-3.0-or-later
            </div>
          </footer>

          <dialog id="site-search" class="modal" aria-label="搜索游戏">
            <div class="modal-box">
              <h2 class="text-lg font-bold">搜索游戏</h2>
              <p class="py-4 text-base-content/70">搜索弹窗待重新设计。</p>
              <div class="modal-action">
                <form method="dialog"><button class="btn">关闭</button></form>
              </div>
            </div>
            <form method="dialog" class="modal-backdrop"><button aria-label="关闭">关闭</button></form>
          </dialog>
        </div>
      )
    }
    <script>
      import { startSwup } from '../lib/swup';
      startSwup();
    </script>
  </body>
</html>
