---
/**
 * Site shell: header, nav and footer are static HTML; only `#swup` is swapped
 * on navigation. The player page uses `bare` and is excluded from swup (see
 * `src/lib/swup.ts`), so leaving or entering it is always a full page load.
 */
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';
import Dock from '../components/Dock.astro';

interface Crumb {
  label: string;
  /** Omitted on the last crumb (the current page). */
  href?: string;
}

interface Props {
  /** Document title. */
  title: string;
  /** Header heading; defaults to `title`. */
  heading?: string;
  /**
   * Breadcrumbs, shown only when given (settings sub-pages). `root` is the
   * page the leading `>` links to; `trail` is the levels below it, current last.
   */
  breadcrumbs?: { root: string; trail: Crumb[] };
  /** Player page: no header/footer, full-viewport content. */
  bare?: boolean;
}

const { title, bare = false, breadcrumbs } = Astro.props;
const heading = Astro.props.heading ?? title;
---

<!doctype html>
<html lang="zh-CN" data-theme="swiss">
  <head>
    <meta charset="utf-8" />
    {/* viewport-fit=cover makes env(safe-area-inset-*) report the notch / home bar (portrait dock). */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · online_gal</title>
  </head>
  <body class="min-h-screen bg-base-100 font-sans text-base-content antialiased">
    {
      bare ? (
        <slot />
      ) : (
        <div class="flex min-h-screen flex-col">
          {/*
            Desktop vs mobile is decided by aspect ratio, not width: `landscape:` (width > height)
            is desktop, `portrait:` (height ≥ width) is mobile.
            Landscape grid: outer margin 24px (px-6). Column 1 = logo / dock, 48px wide.
            Gutter 48px. Column 2 starts at 120px (landscape:pl-30): page title, content, footer.
            Portrait: single column at px-6; the dock floats at the bottom, so the page reserves
            room below the footer (dock 48px + 24px offset + 24px gap + safe area).
          */}
          <header>
            <div class="flex h-24 items-center justify-between px-6">
              <div class="flex items-center">
                <a href="/" class="flex shrink-0 items-center" aria-label="online_gal 首页">
                  <Image src={logo} alt="" width={48} height={48} densities={[1, 2]} class="size-12" loading="eager" />
                </a>
                {/* Swup container: replaced on every visit, fades with the content. */}
                <h1 id="page-title" class="transition-fade ml-6 text-3xl font-bold tracking-tight landscape:ml-12">
                  {heading}
                </h1>
              </div>
              {/* Right-side button group: empty for now, filled as features land. */}
              <div class="flex items-center gap-2" role="group" aria-label="操作" />
            </div>
          </header>

          {/*
            Breadcrumbs under the header, on column 2, path-style: `>` is the section root and
            `/` precedes every level, spaced by gap-x-2 (`> / 音频`, `> / 音频 / 子项`). Swup container, fades with the content. The element is always
            rendered (swup needs every container on both sides of a visit) and empty when the
            page has no breadcrumbs.
          */}
          <div id="breadcrumbs" class="transition-fade px-6 text-sm landscape:pl-30">
            {breadcrumbs && (
              <nav aria-label="面包屑">
                <ol class="flex flex-wrap items-center gap-x-2 text-base-content/40">
                  <li>
                    {breadcrumbs.trail.length === 0 ? (
                      <span aria-current="page" class="text-base-content">&gt;</span>
                    ) : (
                      <a href={breadcrumbs.root} aria-label={heading} class="hover:text-base-content">&gt;</a>
                    )}
                  </li>
                  {breadcrumbs.trail.map((crumb, i) => (
                    <li class="flex items-center gap-x-2">
                      <span aria-hidden="true">/</span>
                      {i < breadcrumbs.trail.length - 1 && crumb.href ? (
                        <a href={crumb.href} class="hover:text-base-content">{crumb.label}</a>
                      ) : (
                        <span aria-current="page" class="text-base-content">{crumb.label}</span>
                      )}
                    </li>
                  ))}
                </ol>
              </nav>
            )}
          </div>

          <Dock />

          <main id="swup" class="transition-fade w-full flex-1 px-6 pt-6 pb-16 landscape:pl-30">
            <slot />
          </main>

          <footer class="border-t border-base-300">
            <div class="px-6 py-4 text-xs text-base-content/60 landscape:pl-30">
              GPL-3.0-or-later
            </div>
          </footer>
        </div>
      )
    }
    <script>
      import { startSwup } from '../lib/swup';
      startSwup();
    </script>
  </body>
</html>
