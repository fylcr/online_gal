/ports/artemis/tools/rg-full-console.mjs

# Reference material (read-only upstream checkouts used for porting and for the
# real-game tests). Not ours to redistribute, and large: fetch these yourself.
# The list of what the ports need is in `ports/README.md`.
#
#   .ref/ak               AetherKiri (GPL-3.0-or-later) — bridge/ and the KAG3 demo
#   .ref/kirikiroid2      Kirikiroid2 (BSD-style)       — TJS2 opcode/bytecode tables
#   .ref/tynext           Tyranor-Next (GPL-2.0-or-later) — engine marker facts only
#   .ref/onscripter-yuri  OnscripterYuri                — the ONScripter web build
#   .ref/kirikiroid2-web  kirikiroid2-web               — the KiriKiri web build
#   .ref/krkrsdl2         krkrsdl2 + krkrz              — the earlier KiriKiri attempt
#   .ref/artemis-compat   artemis-compat                — naming/structure reference
#   .ref/vcpkg            vcpkg                         — KiriKiri's dependency manager
#   .ref/emsdk            Emscripten SDK                — optional; /d/emsdk also works
#   .ref/*-game           real game data                — never redistributable
#
# `.test/real-game.test.ts` runs against `.ref/ak/demos/aetherkiri-kag3/data`
# and skips cleanly when it is absent.
.ref/

# Test suite. Deliberately untracked: the tests are a local workbench.
#
# If tests should be committed, they belong in a tracked `test/` directory —
# `test/` is not ignored, `.test/` is. Keeping the two names distinct means a
# clone can ship its own `test/` without colliding with this local suite.
.test/

# Port build output. The recipes in `ports/` are tracked; what they produce is not.
# Each `build-emscripten.sh` / `run-*.sh` writes into its own `out/` directory.
ports/**/out/
ports/**/build-final/
ports/**/*.wasm
ports/**/*.o

# vcpkg's binary cache, as the CI workflow points it here (`VCPKG_BINARY_CACHE` in
# `build-wasm-reusable.yml`). It saves and restores this directory to stop KiriKiri
# rebuilding OpenCV, boost, bullet and 7zip from source on every run — it is a few GB
# of derived archives, and only ever exists on a build machine.
.vcpkg-binary-cache/

# Retained asset exception: `ports/artemis/vendor/` contains official SDK inputs.
# Preserve existing files during source organization; this exception is NOT a
# redistribution grant. Artemis's own copyright reserves all rights, and the
# SDK/derived-product boundary needs separate review (THIRD_PARTY_NOTICES.md).
# CI still uses the asyncify binary as wasm2c input. Official glue is diagnostic,
# not the shipping host; generated build output remains ignored elsewhere.
!ports/artemis/vendor/**

# Downloaded third-party toolchains. These are fetched, not authored: wabt is the
# wasm disassembler/transpiler and Zig supplies the AArch64 cross-linker that the
# `so` half of `ports/artemis/reverse/rebuild.sh` needs. Both are pinned by the
# `fetch-*.sh` scripts next to the recipes that use them, so committing a copy
# would only add ~570 MB of binaries that the fetchers restore exactly.
ports/artemis/build/wabt/
ports/artemis/reverse/build/

# Intermediates from the same recipes: the .wat/.c dumps are derivative works of
# the proprietary SDK, hundreds of MB of them, and `rebuild.sh` regenerates each
# from the vendored binaries in minutes.
ports/artemis/reverse/out/

# Scratch space for the hand-rewrite pass: a product is written here, checked
# against the generated body it replaces, and only then moved into
# `ports/artemis/src/`, which is where the tracked copy lives.
ports/artemis/rewrite-staging/

# Python tooling bytecode. The deploy/analysis recipes are tracked; the caches
# their interpreter drops beside them are not.
__pycache__/
*.pyc

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
