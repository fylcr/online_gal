{
  "name": "online-gal",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-hosted multi-runtime visual novel platform",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:packages": "tsc -b tsconfig.packages.json && node packages/engine/core/onscripter-yuri/scripts/copy-runtime-assets.mjs && node packages/engine/core/artemis-compat/scripts/copy-compat-worker.mjs",
    "build": "npm run build:packages && pnpm --filter @online-gal/app build",
    "build:site": "npm run build && node packages/plugin-system/scripts/build-site.mjs",
    "dev": "npm run build:packages && pnpm --filter @online-gal/app dev",
    "preview": "pnpm --filter @online-gal/app preview",
    "check": "npm run check:layout && tsc -b tsconfig.packages.json && pnpm --filter @online-gal/app check",
    "check:layout": "node scripts/check-layout.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "test:sources": "node --test test/check-sources.test.mjs",
    "test:portable": "node scripts/run-portable-tests.mjs",
    "test": "npm run check:layout && npm run build:packages && node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.1.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.14.2"
}
