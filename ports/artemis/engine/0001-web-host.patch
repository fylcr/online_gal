+//
+// Only `delete` is reachable from the framework that ships with this game:
+// system/adv/fsave.lua:308 sv.deleteno() calls deleteFile(path..'.dat') to
+// remove a save slot, and fileio.lua:291 forwards it here. The target is a
+// file under the save directory (`s.savepath`), not an asset in the pack —
+// fsave.lua:307 builds it as e:var("s.savepath")..'/'..file.
+//
+// The wasm_sync* commands configure the SDK's WASM SYNC mode, which this port
+// does not use (asyncify reads loose files instead), so they are deliberately
+// not implemented rather than silently wrong.
+bool LuaEngine::TagFile(const std::string &tag, TagAttrs &m) {
+    const std::string command = m.count("command") ? m["command"] : std::string();
+    if (command != "delete") return false;
+    if (!m.count("target") || m["target"].empty()) return false;
+    // Strip the save-directory prefix the framework prepends; DeleteSaveFile
+    // re-applies it through SavePath and rejects anything that escapes.
+    std::string target = m["target"];
+    if (!save_dir_.empty() && target.rfind(save_dir_, 0) == 0) {
+        target.erase(0, save_dir_.size());
+        while (!target.empty() && (target[0] == '/' || target[0] == '\\')) target.erase(0, 1);
+    }
+    return DeleteSaveFile(save_dir_, target);
