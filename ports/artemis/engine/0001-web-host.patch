diff --git a/CMakeLists.txt b/CMakeLists.txt
index e2290fa..1afb2d3 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -139,3 +139,180 @@ if(ARTC_BUILD_MAC_HOST AND APPLE)
     target_link_libraries(artemis-mac PRIVATE artemis_deps
         "-framework Cocoa" "-framework OpenGL")
 endif()
+
+# ---- web host (Emscripten: canvas + WebGL2 through the GLES2 entry points) ----
+#
+# Same shape as the macOS host above: the core is recompiled into this target with `ARTC_HAS_GLES=1`
+# so the compositor and layer shaders take the real GL path, while `artemis_core` stays GL-free for
+# the CLI and the regression suite.
+#
+# Flag rationale:
+#   -sMIN/-sMAX_WEBGL_VERSION=2   the compositor targets GLES2, which is a subset of ES3; pinning
+#                                 WebGL2 keeps the driver from choosing WebGL1 and dropping the ES2
+#                                 entry points the compositor relies on
+#   -sFULL_ES2=1                  link the full GLES2 entry points rather than the trimmed default set
+#   -sALLOW_MEMORY_GROWTH=1       Emscripten 6.x leaves growth off, so the heap is fixed at
+#                                 INITIAL_MEMORY and booting a real title aborts with `Aborted(OOM)`
+#                                 on the first sizeable allocation
+#   -sSTACK_SIZE=4MB              the boot chain recurses through Lua and the .asb runner; the default
+#                                 64 KB stack is not enough
+#
+# There is deliberately no `--shell-file`: the page (`src/host/web_page.html`) owns the canvas element
+# and the input, and the module is loaded by a worker that the page starts, so Emscripten's shell would
+# be dead weight. `#canvas` is the selector the host creates its GL context against — see
+# `kCanvasTarget` in `src/host/web_main.cpp` for why a target string rather than `0`.
+if(EMSCRIPTEN)
+    option(ARTC_BUILD_WEB_HOST "Build the Emscripten web host" ON)
+endif()
+if(ARTC_BUILD_WEB_HOST AND EMSCRIPTEN)
+    add_executable(artemis-web ${ARTC_CORE_SOURCES}
+        ${CMAKE_CURRENT_SOURCE_DIR}/src/host/web_main.cpp)
+    target_include_directories(artemis-web PRIVATE
+        ${CMAKE_CURRENT_SOURCE_DIR}/src/render
+        ${CMAKE_CURRENT_SOURCE_DIR}/third_party)
+    target_compile_definitions(artemis-web PRIVATE ARTC_HAS_GLES=1)
+    target_link_options(artemis-web PRIVATE
+        # No `main`: the page drives the host through the exported `artc_web_*` entry points.
+        --no-entry
+        -sINVOKE_RUN=0
+        # The module runs in a **worker**, which is what makes its byte source legal as well as cheap:
+        # `XMLHttpRequest` with async=false throws on the main thread but is fine in a worker, so the
+        # pack reads simply complete instead of suspending anything.
+        -sENVIRONMENT=worker
+        -sMIN_WEBGL_VERSION=2
+        -sMAX_WEBGL_VERSION=2
+        -sFULL_ES2=1
+        -sALLOW_MEMORY_GROWTH=1
+        -sINITIAL_MEMORY=64MB
+        -sMAXIMUM_MEMORY=4GB
+        -sSTACK_SIZE=4MB
+        # On by default, unlike in a typical build. Without it a wasm trap surfaces as a bare
+        # `RuntimeError: Aborted()` with no reason at all — the message is literally what Emscripten
+        # prints and its own advice is "build with -sASSERTIONS for more info". During a port the
+        # difference between `Aborted()` and `Aborted(OOM)` is the difference between a mystery and a
+        # fix, and that is worth the size.
+        -sASSERTIONS=1
+        -sEXPORTED_RUNTIME_METHODS=ccall,cwrap,HEAPU8,FS,UTF8ToString
+        -sEXPORTED_FUNCTIONS=_malloc,_free)
+    target_link_libraries(artemis-web PRIVATE artemis_deps)
+    set_target_properties(artemis-web PROPERTIES SUFFIX ".js")
+
+    # A second, diagnostic build of the same host.
+    #
+    # Emscripten reports a wasm trap as a bare `Aborted()` and its own advice is "build with
+    # -sASSERTIONS for more info" — which is the difference between a stack trace naming the function
+    # and an offset with no attribution. `-g` is what puts function names in the wasm for that trace.
+    #
+    # Off by default because none of it belongs in a shipping build: assertions add checks and messages
+    # to every call, and `-g` grows the binary several-fold. Used via a separate build directory so the
+    # shipping artefacts are never overwritten by a diagnostic one.
+    option(ARTC_WEB_DIAGNOSTICS "Build the web host with assertions, stack checks and debug info" OFF)
+    if(ARTC_WEB_DIAGNOSTICS)
+        target_compile_options(artemis-web PRIVATE -g)
+        target_link_options(artemis-web PRIVATE -g -sASSERTIONS=2 -sSTACK_OVERFLOW_CHECK=2)
+    endif()
+endif()
+
+# ---------------------------------------------------------------------------
+# The engine's *Android* host, retargeted at wasm.
+#
+# Why a second web target: `src/jni/native_activity.cpp` is the host where this engine is known to
+# render correctly, and re-implementing it by hand (the `artemis-web` target) is how a whole class of
+# "the host behaves subtly differently" bugs got introduced. This target compiles that host and its
+# EGL/GLES2 renderer **unmodified**, against the thin NDK/JNI shim in `ARTC_ANDROID_SHIM`.
+#
+# `__ANDROID__` is set **only for renderer.cpp**: it selects the real EGL implementation there while
+# leaving audio.cpp on its non-OpenSL path.
+# ---------------------------------------------------------------------------
+option(ARTC_BUILD_WEB_ANDROID_HOST "Build the Android NativeActivity host for wasm" OFF)
+set(ARTC_ANDROID_SHIM "" CACHE PATH "Directory holding the android/ + jni.h shims")
+if(ARTC_BUILD_WEB_ANDROID_HOST AND EMSCRIPTEN)
+    add_executable(artemis-web-android ${ARTC_CORE_SOURCES}
+        ${CMAKE_CURRENT_SOURCE_DIR}/src/jni/native_activity.cpp
+        ${CMAKE_CURRENT_SOURCE_DIR}/src/render/renderer.cpp
+        ${ARTC_ANDROID_SHIM}/src/shim.cpp)
+    target_include_directories(artemis-web-android PRIVATE
+        ${ARTC_ANDROID_SHIM}/include
+        ${CMAKE_CURRENT_SOURCE_DIR}/src/render
+        ${CMAKE_CURRENT_SOURCE_DIR}/third_party)
+    target_compile_definitions(artemis-web-android PRIVATE ARTC_HAS_GLES=1)
+    target_compile_options(artemis-web-android PRIVATE -pthread)
+    # `-pthread` makes the link use `--shared-memory`, which requires **every** object to be built
+    # with atomics. `lua51` is a separate static library, so it needs the flag too or wasm-ld
+    # rejects it: "--shared-memory is disallowed by ldo.c.o ... not compiled with 'atomics'".
+    # Declared here rather than beside `add_library(lua51)` because this option does not exist yet
+    # at that point in the file, which silently makes the condition false.
+    target_compile_options(lua51 PRIVATE -pthread)
+    set_source_files_properties(${CMAKE_CURRENT_SOURCE_DIR}/src/render/renderer.cpp
+        PROPERTIES COMPILE_DEFINITIONS "__ANDROID__=1")
+    target_link_options(artemis-web-android PRIVATE
+        --no-entry -sINVOKE_RUN=0
+        # The engine's host spawns its own std::thread and renders from it, so threads are not optional.
+        # `PTHREADS` is an internal setting in this Emscripten version; threads are requested with
+        # the compiler/linker flag `-pthread` instead.
+        -sENVIRONMENT=worker -pthread
+        # The Android host spawns two threads (the engine/render loop and the input looper) from
+        # inside `ANativeActivity_onCreate`. With the default pool size of 0 every spawn is queued
+        # rather than run and the engine simply never starts:
+        #   "Tried to spawn a new thread, but the thread pool is exhausted."
+        -sPTHREAD_POOL_SIZE=6
+        # `ListPacks` finds the pack chain by LISTING the app data directory (opendir + a `.pfs`
+        # suffix test). That happens on the engine's own pthread, where Emscripten's MEMFS is a
+        # separate empty instance, so no filesystem populated from the page can reach it. The shim
+        # answers those three calls from memory shared across threads instead; wrapping at link time
+        # keeps the engine unmodified. See android-shim/src/shim.cpp.
+        -Wl,--wrap=opendir,--wrap=readdir,--wrap=closedir
+        # Boundary instrumentation for the same problem: the engine prints nothing between
+        # `Renderer::Init` entry and its final "GLES2 ready" line, so when it goes silent we cannot
+        # tell *which* EGL step blocked. Wrapping the EGL symbols puts a log line on either side of
+        # each real call, logged from the engine thread, so an "enter" without a matching "leave"
+        # names the exact blocking call. See android-shim/src/shim.cpp.
+        -Wl,--wrap=eglGetDisplay,--wrap=eglInitialize,--wrap=eglChooseConfig,--wrap=eglCreateContext,--wrap=eglCreateWindowSurface,--wrap=eglMakeCurrent,--wrap=eglSwapBuffers,--wrap=eglSwapInterval
+        # Same idea one layer down: the EGL trace staying silent means the thread never reaches
+        # `Renderer::Init`, so the next question is whether it reaches GL at all (the first GL call in
+        # the host is `Compositor::ReleaseGl` at native_activity.cpp:418, before any `Start()`).
+        -Wl,--wrap=glDeleteTextures,--wrap=glDeleteProgram,--wrap=glDeleteFramebuffers,--wrap=glGenTextures,--wrap=glCreateProgram,--wrap=glCreateShader,--wrap=glBindFramebuffer,--wrap=glBindTexture,--wrap=glTexImage2D
+        # The one GL call that must be synchronous: see the long note in android-shim/src/shim.cpp.
+        # The engine draws exclusively from client-side vertex arrays, whose pointer stays live until
+        # the draw reads it on the main thread — and OFFSCREEN_FRAMEBUFFER compiles glDrawArrays as an
+        # *async* proxy, so the engine thread would overwrite that memory before it is ever read.
+        -Wl,--wrap=glDrawArrays
+        # And the host loop itself, by mangled name: `Renderer::Init` is the only way into EGL, and
+        # `Compositor::ReleaseGl` is the first GL call the very first loop iteration makes.
+        # -Wl,--wrap=_ZN4artc8Renderer4InitEPv,--wrap=_ZN4artc10Compositor9ReleaseGlEv,--wrap=_ZN4artc10Compositor6UpdateEd
+        -Wl,--wrap=_ZN4artc8Renderer4InitEPv,--wrap=_ZN4artc10Compositor9ReleaseGlEv,--wrap=_ZN4artc10Compositor4DrawEv
+        # NOTE: `--wrap=_ZN4artc10Compositor6UpdateEd` (and its wrapper) is deliberately absent: with
+        # that third symbol in the list, `wasm-ld` emits a module that binaryen rejects
+        # ("Fatal: error parsing wasm", "[parse exception: popping from empty stack]") and the link
+        # fails. The two symbols above are enough to place the boundary.
+        -sMIN_WEBGL_VERSION=2 -sMAX_WEBGL_VERSION=2 -sFULL_ES2=1
+        # The engine renders from its own std::thread, and its renderer.cpp talks **EGL**. In this
+        # Emscripten version every EGL entry point (eglGetDisplay … eglSwapBuffers) is `__proxy: 'sync'`
+        # from a pthread, so the WebGL context is created on — and owned by — the main runtime thread.
+        # Without OFFSCREEN_FRAMEBUFFER the raw `gl*` calls are plain `GLctx.x()` on the *calling*
+        # thread, and a pthread's `GLctx` is undefined because the context lives on the main thread:
+        # the first `glViewport()` in `Renderer::Init` then dereferences undefined.
+        # OFFSCREEN_FRAMEBUFFER compiles system/lib/gl/webgl{1,2}.c into the pthread-proxying form, so
+        # each GL call is routed to the thread that owns the context. This is the Emscripten-sanctioned
+        # way to run GL from a pthread and it is what the upstream pthread+GL tests use.
+        -sOFFSCREEN_FRAMEBUFFER=1
+        -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=64MB -sMAXIMUM_MEMORY=4GB -sSTACK_SIZE=4MB
+        -sASSERTIONS=1
+        # The sync-proxy queue is pumped by the host worker rather than by the SDK. In the SDK the only
+        # caller is `emscripten_yield.c:50`, reached from the main thread's futex busy-wait loop — i.e.
+        # only while the main thread is blocked. Here the main runtime thread is an idle Web Worker
+        # event loop, so nothing drains it and a pthread blocks forever in its first proxied call.
+        #
+        # `_emscripten_check_mailbox` is the pump that also keeps the SDK's own wake-up path alive:
+        # `emscripten_current_thread_process_queued_calls` (`library_pthread.c:94`) calls
+        # `emscripten_proxy_execute_queue` directly, which runs the queued tasks but never runs
+        # `receive_notification` — the only code that resets the queue's `notification` state to
+        # `NOTIFICATION_NONE` (proxying.c:178, em_task_queue.c:209). Left `PENDING` by a direct drain, it
+        # makes `em_task_queue_send` skip `emscripten_thread_mailbox_send` forever, so no further mailbox
+        # notification is ever delivered. `__emscripten_check_mailbox` runs the mailbox task instead and
+        # therefore both drains the queue and restores the notification handshake.
+        -sEXPORTED_RUNTIME_METHODS=ccall,cwrap,HEAPU8,FS,UTF8ToString
+        -sEXPORTED_FUNCTIONS=_artc_android_boot,_artc_shim_push_motion,_artc_shim_push_key,_artc_shim_add_pack,_emscripten_main_thread_process_queued_calls,__emscripten_check_mailbox,_malloc,_free)
+    target_link_libraries(artemis-web-android PRIVATE artemis_deps)
+    set_target_properties(artemis-web-android PROPERTIES SUFFIX ".js")
+endif()
diff --git a/src/host/web_main.cpp b/src/host/web_main.cpp
new file mode 100644
index 0000000..ab5d346
--- /dev/null
+++ b/src/host/web_main.cpp
@@ -0,0 +1,525 @@
+//---------------------------------------------------------------------------
+// Web (Emscripten) host for artemis-compat.
+//
+// Modelled directly on `src/host/mac_main.mm`. The boot sequence, the queued-input model and the
+// per-frame order are the same, deliberately: reset/exit gate -> boot -> drain input -> EnterFrame ->
+// drain queued tags -> Step -> compositor update -> gated Present -> EndFrame. Keeping the order
+// identical means a bug found on one host is a bug on the other, rather than a difference in hosts.
+//
+// Only the platform surface differs:
+//
+//   Cocoa window + legacy OpenGL 2.1   ->  a canvas + a WebGL2 context through Emscripten's GLES2
+//   NSTimer at the display refresh     ->  requestAnimationFrame (`emscripten_set_main_loop(fn, 0, 1)`)
+//   NSEvent                            ->  browser events, via the exported C entry points below
+//
+// The redraw gate is kept as-is. It matters more here than on the desktop: a browser compositor
+// charges for every presented frame, and an ADV scene is static most of the time, so skipping
+// clear+draw when the layer revision has not moved and nothing is animating is the difference
+// between a warm laptop and a hot one.
+//---------------------------------------------------------------------------
+
+#include <emscripten.h>
+#include <emscripten/html5.h>
+
+#include <GLES2/gl2.h>
+
+#include "config/ini.h"
+#include "core/engine_context.h"
+#include "log/logger.h"
+#include "pack/pack_manager.h"
+#include "render/compositor.h"
+#include "script/asb_parser.h"
+#include "script/dialog_request.h"
+#include "script/iet_interpreter.h"
+#include "script/lua_engine.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <deque>
+#include <memory>
+#include <string>
+#include <vector>
+
+/**
+ * Bridges a `[dialog]` request to the page, **synchronously**.
+ *
+ * The Android host does the same thing with a poll loop (`ShowNativeInput`): it posts the request to
+ * the UI thread and waits. In a browser the wait is free, because `confirm`/`prompt` block the
+ * calling thread by design — so the tag's synchronous request/response contract survives with no
+ * async plumbing, and the engine does not need to be resumable.
+ *
+ * Returns a string the caller must `free`. `stringToNewUTF8` puts it on the wasm heap, which is the
+ * only way a JS string can outlive the call; a JS-side string is garbage after the call returns.
+ * Returns 0 when the page installed no handler, which the caller treats as "declined".
+ *
+ * `kind`: 0 = message-only, 1 = yes/no confirm, 2 = text input.
+ */
+EM_JS(char *, artc_js_dialog, (const char *title, const char *message, int kind), {
+    if (typeof window === 'undefined' || typeof window.__artcDialog !== 'function') {
+        return 0;
+    }
+    try {
+        const result = window.__artcDialog(kind, UTF8ToString(title), UTF8ToString(message));
+        return stringToNewUTF8(result === null || result === undefined ? '' : String(result));
+    } catch (error) {
+        console.error('[artc] dialog handler threw', error);
+        return 0;
+    }
+});
+
+using namespace artc;
+
+namespace {
+
+constexpr int kKeyTap = 1;
+
+/**
+ * How the GL canvas is named to Emscripten.
+ *
+ * Every `emscripten_*` entry point that takes a canvas takes a **target string**, and resolution is
+ * `document.querySelector(target)` — so the target has to be a selector the host can answer. The canvas
+ * is `#canvas` in the page, and the worker's `document` shim answers the same selector with the
+ * `OffscreenCanvas` it was handed, which keeps one name working on both hosts.
+ *
+ * Worth stating because the obvious spelling is wrong: `0` is not "the default canvas" here.
+ * Emscripten looks a numeric target up in `specialHTMLTargets`, whose slot 0 is the literal `0` (the
+ * document sits in slot 1), so a `0` target falls through to `document.querySelector(0)` and resolves
+ * nothing — on the main thread as much as in a worker. That produced a `create_context` failure with no
+ * GL error and no explanation, because the call never reached WebGL.
+ */
+constexpr const char *kCanvasTarget = "#canvas";
+
+struct RawInput {
+    bool is_key = false;
+    bool is_move = false;
+    bool down = false;
+    int key = 0;
+    float x = 0, y = 0;
+};
+
+class WebEngine {
+public:
+    bool Open(const std::string &game_path, const std::string &os) {
+        ctx = std::make_unique<EngineContext>();
+        if (!ctx->Open(game_path, os)) {
+            ctx.reset();
+            return false;
+        }
+        stage_w = ctx->stageW();
+        stage_h = ctx->stageH();
+        Log(kLogInfo, "web host: stage=" + std::to_string(stage_w) + "x" + std::to_string(stage_h));
+        return true;
+    }
+
+    bool Boot() {
+        if (!ctx || !ctx->Start()) return false;
+
+        // The `[dialog]` host box.
+        //
+        // The Android host (`src/jni/native_activity.cpp`, `ShowNativeInput`) answers these
+        // **synchronously**: it posts the request to the UI thread and polls until the box is
+        // dismissed, with the engine paused meanwhile. The browser can do the same thing more
+        // directly, because `window.confirm` and `window.prompt` are themselves synchronous and block
+        // the calling thread — so the tag's request/response contract is preserved with no async
+        // plumbing at all.
+        //
+        // Answering with a fabricated value would be worse than refusing: accepting a `[confirm]` the
+        // player never saw tells the game to take a branch on its own.
+        ctx->lua().SetDialogHandler([](DialogRequest &req) -> bool {
+            const int kind = req.has_input ? 2 : (req.has_result ? 1 : 0);
+            char *answer = artc_js_dialog(req.title.c_str(), req.message.c_str(), kind);
+            if (!answer) {
+                req.accepted = false;
+                return false;
+            }
+            const std::string text = answer;
+            free(answer);
+            if (kind == 2) {
+                // A prompt returns the typed text, or null when cancelled; the page encodes cancel as
+                // an empty answer, which is also a legitimate empty entry, so acceptance is decided by
+                // the page and reported through `accepted`.
+                req.accepted = !text.empty() || req.has_input;
+                req.text = text;
+                if (req.textfieldsize > 0 && req.text.size() > (size_t)req.textfieldsize) {
+                    req.text.resize(req.textfieldsize);
+                }
+                return req.accepted;
+            }
+            req.accepted = text == "1";
+            return req.accepted;
+        });
+
+        if (!ctx->BootFramework()) return false;
+        booted = true;
+        return true;
+    }
+
+    void Enqueue(const RawInput &ev) {
+        events.push_back(ev);
+        if (events.size() > 512) events.pop_front();
+    }
+
+    void Pointer(float x, float y, bool move, bool down) {
+        RawInput ev;
+        ev.x = x;
+        ev.y = y;
+        ev.is_move = move;
+        ev.down = down;
+        ev.key = kKeyTap;
+        Enqueue(ev);
+    }
+
+    void Key(int key, bool down) {
+        RawInput ev;
+        ev.is_key = true;
+        ev.key = key;
+        ev.down = down;
+        Enqueue(ev);
+    }
+
+    void Resize(int w, int h) {
+        css_w = w;
+        css_h = h;
+    }
+
+    bool ExitRequested() const { return exit_requested; }
+    bool Started() const { return ctx && ctx->Started(); }
+    int StageWidth() const { return stage_w; }
+    int StageHeight() const { return stage_h; }
+    unsigned long long Revision() const {
+        return (ctx && ctx->Started()) ? ctx->compositor().Revision() : 0ull;
+    }
+    unsigned long long Presented() const { return presented; }
+    const char *LastError() const { return last_error.c_str(); }
+
+    /**
+     * Record why a host entry point refused.
+     *
+     * `artc_web_open` has two independent reasons to fail — no GL context, or no pack — and the page
+     * can only see the combined answer. Without a reason string here both collapse into the same
+     * "open failed" with no detail, which is indistinguishable from the boot chain having died.
+     */
+    void SetLastError(const std::string &message) { last_error = message; }
+
+    /**
+     * One frame. Mirrors `mac_main.mm`'s `Tick` step for step.
+     *
+     * The backing-store size is read every frame rather than cached: a browser resizes a canvas by
+     * changing its attributes, and a stale viewport shows up as a stretched or cropped picture rather
+     * than as an error.
+     */
+    void Tick() {
+        int fb_w = stage_w, fb_h = stage_h;
+        emscripten_get_canvas_element_size(kCanvasTarget, &fb_w, &fb_h);
+        if (fb_w <= 0 || fb_h <= 0) {
+            fb_w = stage_w;
+            fb_h = stage_h;
+        }
+
+        if (ctx && ctx->Started() && ctx->lua().ConsumeResetRequest()) {
+            Log(kLogInfo, "web host: reset requested; re-running the boot chain");
+            ctx->ResetSession();
+            booted = false;
+            drawn_rev = ~0ull;
+        }
+        if (ctx && ctx->Started() && ctx->lua().ConsumeExitRequest()) {
+            Log(kLogInfo, "web host: exit requested");
+            exit_requested = true;
+            return;
+        }
+        if (!booted && !Boot()) {
+            last_error = "boot failed";
+            exit_requested = true;
+            return;
+        }
+
+        DrainInput();
+        if (ctx && ctx->Started()) {
+            ctx->lua().RunEnterFrame();
+            DrainQueued();
+        }
+        Step();
+        if (ctx && ctx->Started()) {
+            ctx->compositor().Update(ctx->lua().NowMs());
+            const double now = ctx->lua().NowMs();
+            const bool animating = ctx->compositor().PendingAnimationMs(now) > 0 ||
+                                   ctx->compositor().TransitionActive() ||
+                                   ctx->compositor().PendingTextMs(now) > 0;
+            if (drawn_rev != ctx->compositor().Revision() || animating) {
+                Present((float)fb_w, (float)fb_h);
+                drawn_rev = ctx->compositor().Revision();
+            }
+            ctx->lua().EndFrame();
+        }
+    }
+
+private:
+    void MapPoint(float px, float py, float *sx, float *sy) const {
+        const float s = std::min((float)css_w / (float)stage_w, (float)css_h / (float)stage_h);
+        const float vw = (float)stage_w * s, vh = (float)stage_h * s;
+        const float vx = ((float)css_w - vw) * 0.5f, vy = ((float)css_h - vh) * 0.5f;
+        *sx = (px - vx) / vw * (float)stage_w;
+        *sy = (py - vy) / vh * (float)stage_h;
+    }
+
+    void DrainInput() {
+        std::deque<RawInput> batch;
+        batch.swap(events);
+        if (!ctx || !ctx->Started()) return;
+
+        LuaEngine *lua = &ctx->lua();
+        int touch = 0;
+        bool tapped = false;
+        float tap_x = 0, tap_y = 0;
+        for (const auto &ev : batch) {
+            if (ev.is_key) {
+                if (ev.down) lua->PushKeyDown(ev.key);
+                else lua->PushKeyUp(ev.key);
+                continue;
+            }
+            float sx = 0, sy = 0;
+            MapPoint(ev.x, ev.y, &sx, &sy);
+            if (ev.is_move) {
+                lua->SetMousePoint(sx, sy);
+                lua->DragMove(sx, sy);
+                continue;
+            }
+            lua->SetMousePoint(sx, sy);
+            if (ev.down) {
+                lua->PushKeyDown(kKeyTap);
+                touch = 1;
+                lua->BeginDrag(sx, sy);
+            } else {
+                lua->PushKeyUp(kKeyTap);
+                touch = 0;
+                const bool dragging = lua->DragMoved();
+                lua->EndDrag();
+                if (!dragging) {
+                    tapped = true;
+                    tap_x = sx;
+                    tap_y = sy;
+                }
+            }
+            lua->SetTouchCount(touch);
+        }
+        if (tapped) lua->ClickAt(tap_x, tap_y);
+    }
+
+    void DrainQueued() {
+        if (!ctx || !ctx->Started()) return;
+        LuaEngine &lua = ctx->lua();
+        AsbRunner &runner = ctx->runner();
+        while (!lua.IsWaiting() && lua.HasQueuedTag()) {
+            std::string name;
+            std::vector<std::pair<std::string, std::string>> attrs;
+            if (!lua.PopQueuedTag(&name, &attrs)) break;
+            if (name == "jump" || name == "call") {
+                std::string file, label;
+                for (const auto &kv : attrs) {
+                    if (kv.first == "file") file = kv.second;
+                    else if (kv.first == "label") label = kv.second;
+                }
+                if (name == "call") runner.Call(file, label);
+                else runner.Jump(file, label);
+            } else {
+                lua.DispatchTag(name, attrs, false);
+            }
+        }
+    }
+
+    void Step() {
+        if (!ctx || !ctx->Started()) return;
+        LuaEngine &lua = ctx->lua();
+        AsbRunner &runner = ctx->runner();
+        if (runner.Loaded() && !runner.Halted() && !lua.IsWaiting()) {
+            for (int i = 0; i < 4 && runner.Loaded() && !runner.Halted(); ++i) {
+                runner.ExecuteLine(lua);
+                DrainQueued();
+                if (lua.IsWaiting()) break;
+            }
+        } else if (!lua.IsWaiting() && lua.HasQueuedTag()) {
+            DrainQueued();
+        }
+    }
+
+    void Present(float fb_w, float fb_h) {
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        glDisable(GL_SCISSOR_TEST);
+        glDisable(GL_DEPTH_TEST);
+        glDisable(GL_CULL_FACE);
+        glViewport(0, 0, (GLsizei)fb_w, (GLsizei)fb_h);
+        glClearColor(0.f, 0.f, 0.f, 1.f);
+        glClear(GL_COLOR_BUFFER_BIT);
+
+        // Letterbox: fit the stage into the canvas and centre it. The stage never stretches, which is
+        // what keeps circles round when the window's aspect ratio differs.
+        const float s = std::min(fb_w / (float)stage_w, fb_h / (float)stage_h);
+        const int vw = (int)((float)stage_w * s), vh = (int)((float)stage_h * s);
+        const int vx = ((int)fb_w - vw) / 2, vy = ((int)fb_h - vh) / 2;
+        glViewport(vx, vy, vw, vh);
+
+        ctx->compositor().Draw();
+        presented += 1;
+    }
+
+    std::unique_ptr<EngineContext> ctx;
+    int stage_w = 1280, stage_h = 720;
+    int css_w = 1280, css_h = 720;
+    bool booted = false;
+    bool exit_requested = false;
+    unsigned long long drawn_rev = ~0ull;
+    unsigned long long presented = 0;
+    std::string last_error;
+    std::deque<RawInput> events;
+};
+
+WebEngine g_engine;
+EMSCRIPTEN_WEBGL_CONTEXT_HANDLE g_gl = 0;
+bool g_loop_started = false;
+
+bool CreateGlContext() {
+    EmscriptenWebGLContextAttributes attrs;
+    emscripten_webgl_init_context_attributes(&attrs);
+    attrs.alpha = false;
+    attrs.depth = false;
+    // Stencil stays on: the compositor masks layers, and a missing stencil buffer shows up as
+    // masks that simply do not apply rather than as a GL error.
+    attrs.stencil = true;
+    attrs.antialias = false;
+    attrs.premultipliedAlpha = true;
+    attrs.preserveDrawingBuffer = false;
+    attrs.majorVersion = 2; // WebGL2. The engine targets GLES2; ES2 calls are a subset of ES3.
+    attrs.minorVersion = 0;
+    attrs.powerPreference = EM_WEBGL_POWER_PREFERENCE_HIGH_PERFORMANCE;
+    attrs.failIfMajorPerformanceCaveat = false;
+
+    g_gl = emscripten_webgl_create_context(kCanvasTarget, &attrs);
+    if (!g_gl) return false;
+    emscripten_webgl_make_context_current(g_gl);
+    // A tainted or lost context is silent otherwise: every later GL call becomes a no-op and the
+    // canvas stays black, which reads like "the engine drew nothing".
+    Log(kLogInfo, std::string("web host: GL ") + (const char *)glGetString(GL_VERSION));
+    return true;
+}
+
+void Frame() {
+    g_engine.Tick();
+    if (g_engine.ExitRequested()) {
+        emscripten_cancel_main_loop();
+    }
+}
+
+} // namespace
+
+//---------------------------------------------------------------------------
+// Entry points for the page.
+//
+// Everything the page needs is an exported C function rather than a raw `ccall` into C++: the
+// signature stays stable, and a mistake in the page surfaces as a failed call instead of as a silent
+// no-op.
+//---------------------------------------------------------------------------
+
+extern "C" {
+
+/** Creates the GL context and opens `pack` (a path inside the Emscripten filesystem). */
+EMSCRIPTEN_KEEPALIVE int artc_web_open(const char *pack, const char *os_id) {
+    if (!CreateGlContext()) {
+        // Naming the target is not decoration: resolution goes through `querySelector(kCanvasTarget)`,
+        // so "no context" here usually means the host could not answer for that selector — which has
+        // nothing to do with WebGL being available.
+        const std::string why = std::string("could not create a WebGL2 context on ") + kCanvasTarget +
+                                " (the host must be able to resolve that selector to its canvas)";
+        Log(kLogError, "web host: " + why);
+        g_engine.SetLastError(why);
+        return 0;
+    }
+    const std::string os = (os_id && *os_id) ? os_id : "windows";
+    if (!g_engine.Open(pack ? pack : "", os)) {
+        const std::string why = std::string("could not open pack: ") + (pack ? pack : "(null)");
+        Log(kLogError, "web host: " + why);
+        g_engine.SetLastError(why);
+        return 0;
+    }
+    return 1;
+}
+
+/**
+ * One frame, driven by the page.
+ *
+ * This is the entry point JSPI needs, and it exists as an **export** rather than as an
+ * `emscripten_set_main_loop` callback on purpose. Emscripten decides which functions to wrap in
+ * `WebAssembly.promising` by comparing `wasmTable.get(ptr)` against `instance.exports.f`; V8 satisfies
+ * that identity by spec but **JavaScriptCore does not**, and where it fails the first suspending read
+ * throws `SuspendError: Suspending() wrapper called outside of a promising() context`. Calling the
+ * export directly sidesteps the comparison entirely, so the same build behaves the same on both
+ * engines. (The reference kirikiroid2-web port found this the hard way and ships
+ * `jspi_jsc_mainloop_fix.js` to force the wrap.)
+ *
+ * Returns 1 to keep running, 0 when the engine has asked to exit.
+ */
+EMSCRIPTEN_KEEPALIVE int artc_web_frame(void) {
+    g_engine.Tick();
+    return g_engine.ExitRequested() ? 0 : 1;
+}
+
+/**
+ * Starts an `emscripten_set_main_loop` frame loop.
+ *
+ * Only for builds without `-sJSPI`; with JSPI the page must drive {@link artc_web_frame} itself and
+ * await it, because a suspend through the main-loop path hits the identity comparison described
+ * above. `fps = 0` means "follow the display refresh".
+ */
+EMSCRIPTEN_KEEPALIVE void artc_web_start(void) {
+    if (g_loop_started) return;
+    g_loop_started = true;
+    emscripten_set_main_loop(Frame, 0, 1);
+}
+
+EMSCRIPTEN_KEEPALIVE void artc_web_stop(void) {
+    if (!g_loop_started) return;
+    g_loop_started = false;
+    emscripten_cancel_main_loop();
+}
+
+/** Pointer input in **CSS pixels** relative to the canvas; the host letterboxes them to the stage. */
+EMSCRIPTEN_KEEPALIVE void artc_web_pointer(float x, float y, int down) {
+    g_engine.Pointer(x, y, 0, down != 0);
+}
+
+EMSCRIPTEN_KEEPALIVE void artc_web_pointer_move(float x, float y) {
+    g_engine.Pointer(x, y, 1, 0);
+}
+
+EMSCRIPTEN_KEEPALIVE void artc_web_key(int key, int down) {
+    g_engine.Key(key, down != 0);
+}
+
+EMSCRIPTEN_KEEPALIVE void artc_web_resize(int css_w, int css_h) {
+    g_engine.Resize(css_w, css_h);
+}
+
+EMSCRIPTEN_KEEPALIVE int artc_web_started(void) { return g_engine.Started() ? 1 : 0; }
+EMSCRIPTEN_KEEPALIVE int artc_web_stage_width(void) { return g_engine.StageWidth(); }
+EMSCRIPTEN_KEEPALIVE int artc_web_stage_height(void) { return g_engine.StageHeight(); }
+EMSCRIPTEN_KEEPALIVE int artc_web_revision(void) { return (int)g_engine.Revision(); }
+EMSCRIPTEN_KEEPALIVE int artc_web_presented(void) { return (int)g_engine.Presented(); }
+EMSCRIPTEN_KEEPALIVE int artc_web_exit_requested(void) { return g_engine.ExitRequested() ? 1 : 0; }
+EMSCRIPTEN_KEEPALIVE const char *artc_web_last_error(void) { return g_engine.LastError(); }
+
+/**
+ * Log sink so page-side code can surface engine output where it likes.
+ *
+ * `SetLogSink` takes a `std::function<void(int, const std::string &)>`, so the C callback is wrapped
+ * rather than bound directly — passing a raw function pointer into a `std::function` by signature
+ * alone does not compile, and the wrapper is where the `const char *` becomes a `std::string`.
+ */
+EMSCRIPTEN_KEEPALIVE void artc_web_log_sink(void (*sink)(int level, const char *message)) {
+    if (!sink) {
+        artc::SetLogSink(artc::LogSink{});
+        return;
+    }
+    artc::SetLogSink([sink](int level, const std::string &message) { sink(level, message.c_str()); });
+}
+
+} // extern "C"
diff --git a/src/host/web_page.html b/src/host/web_page.html
new file mode 100644
index 0000000..453a8cd
--- /dev/null
+++ b/src/host/web_page.html
@@ -0,0 +1,183 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Artemis (web host)</title>
+<style>
+  html, body { margin: 0; height: 100%; background: #000; overflow: hidden; }
+  #canvas { display: block; width: 100%; height: 100%; background: #000; touch-action: none; }
+  #overlay {
+    position: fixed; left: 8px; top: 8px; color: #ddd; font: 12px/1.5 ui-monospace, monospace;
+    background: rgba(0,0,0,.6); padding: 6px 8px; border-radius: 4px; white-space: pre;
+    pointer-events: none; max-width: 70ch;
+  }
+</style>
+</head>
+<body>
+<canvas id="canvas" tabindex="0"></canvas>
+<div id="overlay">loading…</div>
+<script>
+  // The page owns the canvas and the input; the engine runs in a worker (see web_worker.js for why).
+  // Transferring the canvas as an OffscreenCanvas is what lets the worker draw at all.
+  const overlay = document.getElementById('overlay');
+  const canvas = document.getElementById('canvas');
+  const params = new URLSearchParams(location.search);
+  const lines = [];
+  let status = {};
+
+  function say(text) {
+    lines.push(text);
+    if (lines.length > 8) lines.shift();
+    render();
+  }
+
+  function render() {
+    overlay.textContent = [
+      ...lines,
+      '',
+      'stage ' + (status.stage || '?'),
+      'frames ' + (status.frames ?? 0) + '  presented ' + (status.presented ?? 0) +
+        '  revision ' + (status.revision ?? 0),
+      'started ' + (status.started ?? 0) + '  heap ' + (status.heapMb ?? '?') + ' MB',
+      'last error ' + (status.error || '(none)'),
+    ].join('\n');
+  }
+
+  // The pack files sit beside the page; `?base=` overrides where they are fetched from.
+  const base = params.get('base') || location.pathname.replace(/[^/]*$/, '');
+  const pack = params.get('pack') || '/game/root.pfs';
+  const os = params.get('os') || 'windows';
+
+  const worker = new Worker('web_worker.js');
+  // Tween resolutions are kept aside rather than only shown. They are the record of what the engine
+  // actually parsed for each animation (`from`, `to`, `from_current`, duration), and the overlay only
+  // holds the last few lines — so a browser check can read `window.__artcTweens` and get all of them
+  // instead of paging through the console, which carries thousands of `tag[trace]` lines a minute.
+  window.__artcTweens = [];
+  window.__artcDraws = [];
+  window.__artcLayer = [];
+  const tweenLog = window.__artcTweens;
+  const drawLog = window.__artcDraws;
+  const layerLog = window.__artcLayer;
+
+  worker.onmessage = function (event) {
+    const data = event.data || {};
+    if (data.type === 'log') {
+      say(data.text);
+      // One ordered stream with a page timestamp. The per-kind buffers below are convenient, but they
+      // destroy interleaving — and the open question is *when* a `lyprop` that moves a parent or changes
+      // an anchor lands relative to the tween that is about to start. postMessage is a single ordered
+      // channel, so this preserves the real sequence.
+      window.__artcSeq = window.__artcSeq || [];
+      window.__artcSeq.push([Math.round(performance.now()), data.text]);
+      if (window.__artcSeq.length > 1500) window.__artcSeq.shift();
+      if (/lytween /i.test(data.text)) {
+        tweenLog.push(data.text);
+        if (tweenLog.length > 500) tweenLog.shift();
+      } else if (/draw\[/i.test(data.text)) {
+        // The draw[] line lists every visible layer with its resolved rect. Keeping it is what makes a
+        // wrong position measurable rather than arguable.
+        drawLog.push(data.text);
+        if (drawLog.length > 400) drawLog.shift();
+      } else if (/bgchain/i.test(data.text)) {
+        // One line per change: a layer's ancestor chain inputs beside the rect they resolve to.
+        window.__artcChain = window.__artcChain || [];
+        window.__artcChain.push(data.text);
+        if (window.__artcChain.length > 200) window.__artcChain.shift();
+      } else if (/lyprop |lyc /i.test(data.text)) {
+        // What created the layer and what its properties were set to — the other half of any question
+        // about a layer that is the wrong size or in the wrong place.
+        layerLog.push(data.text);
+        if (layerLog.length > 500) layerLog.shift();
+      }
+    } else if (data.type === 'status') { status = data; render(); }
+  };
+  worker.onerror = function (event) {
+    say('worker error: ' + (event.message || '(no message)'));
+    console.error('[artc] worker error', event);
+  };
+
+  function cssSize() {
+    return { width: canvas.clientWidth || window.innerWidth, height: canvas.clientHeight || window.innerHeight };
+  }
+
+  let dpr = window.devicePixelRatio || 1;
+
+  // The backing store is sized **before** the canvas is transferred, and never again from the page:
+  // `transferControlToOffscreen` hands ownership away, and touching `canvas.width` afterwards throws
+  //   InvalidStateError: Cannot resize canvas after call to transferControlToOffscreen().
+  // Later resizes are therefore sent to the worker, which resizes the OffscreenCanvas it owns.
+  function sizeBackingStore() {
+    const size = cssSize();
+    canvas.width = Math.max(1, Math.round(size.width * dpr));
+    canvas.height = Math.max(1, Math.round(size.height * dpr));
+    return size;
+  }
+
+  window.addEventListener('resize', function () {
+    dpr = window.devicePixelRatio || 1;
+    const size = cssSize();
+    worker.postMessage({ type: 'resize', width: size.width, height: size.height, dpr: dpr });
+  });
+
+  // Engine key ids, mapped in one place rather than spread through the C++ entry point.
+  const KEY_MAP = {
+    Escape: 8, Backspace: 8, Enter: 1, ' ': 1,
+    ArrowUp: 2, ArrowDown: 3, ArrowLeft: 4, ArrowRight: 5,
+    Control: 6, Shift: 7, Tab: 9, PageUp: 10, PageDown: 11,
+  };
+
+  function point(event) {
+    // CSS pixels relative to the canvas; the worker letterboxes them to the stage.
+    const rect = canvas.getBoundingClientRect();
+    return { x: event.clientX - rect.left, y: event.clientY - rect.top };
+  }
+
+  canvas.addEventListener('pointerdown', function (e) {
+    // Guarded, because the throw would land *before* the postMessage: a synthetic pointer — browser
+    // automation, or any pointer id the browser does not consider currently active — makes
+    // `setPointerCapture` raise `NotFoundError`, and the host then never sees the press at all. The
+    // press is what matters; the capture is only a nicety for drags that leave the element.
+    try { canvas.setPointerCapture(e.pointerId); }
+    catch (error) { /* not an active pointer; the press still counts */ }
+    const p = point(e);
+    worker.postMessage({ type: 'pointer', x: p.x, y: p.y, down: 1 });
+  });
+  canvas.addEventListener('pointerup', function (e) {
+    const p = point(e);
+    worker.postMessage({ type: 'pointer', x: p.x, y: p.y, down: 0 });
+  });
+  canvas.addEventListener('pointermove', function (e) {
+    const p = point(e);
+    worker.postMessage({ type: 'pointermove', x: p.x, y: p.y });
+  });
+  canvas.addEventListener('contextmenu', function (e) { e.preventDefault(); });
+  window.addEventListener('keydown', function (e) {
+    const key = KEY_MAP[e.key];
+    if (key === undefined) return;
+    e.preventDefault();
+    worker.postMessage({ type: 'key', key: key, down: 1 });
+  });
+  window.addEventListener('keyup', function (e) {
+    const key = KEY_MAP[e.key];
+    if (key === undefined) return;
+    e.preventDefault();
+    worker.postMessage({ type: 'key', key: key, down: 0 });
+  });
+
+  const size = sizeBackingStore();
+  const offscreen = canvas.transferControlToOffscreen();
+  worker.postMessage({
+    type: 'canvas',
+    canvas: offscreen,
+    pack: pack,
+    os: os,
+    base: base,
+    width: size.width,
+    height: size.height,
+    dpr: dpr,
+  }, [offscreen]);
+</script>
+</body>
+</html>
diff --git a/src/host/web_worker.js b/src/host/web_worker.js
new file mode 100644
index 0000000..bdbebfa
--- /dev/null
+++ b/src/host/web_worker.js
@@ -0,0 +1,272 @@
+/**
+ * The artemis-compat web host, running **inside a worker**.
+ *
+ * Why a worker rather than the page: the engine's pack reads are synchronous by design
+ * (`Pf8Reader::ReadAt` is a blocking, positional read), and the only way to serve bytes synchronously in
+ * a browser is `XMLHttpRequest` with `async = false` — which the main thread forbids with
+ * `InvalidAccessError` and a worker allows.
+ *
+ * Two earlier attempts failed by trying to keep the engine on the main thread and make the read
+ * *appear* synchronous instead: JSPI suspends the wasm stack, and its switch did not preserve the
+ * caller's frames (`PackManager::OpenChain`'s `base_path` came back as a fragment of unrelated memory);
+ * Asyncify saves and restores the stack itself, but the write it performs after its `await` was
+ * measured landing **after** the wasm had resumed, so `ReadAt` returned with its buffer still zero. A
+ * read that simply completes needs neither mechanism.
+ *
+ * The canvas arrives as an `OffscreenCanvas` transferred from the page; input arrives as messages.
+ */
+/* global importScripts, self */
+
+// Where the pack files are served from, and the engine inputs. Filled in when the canvas arrives.
+let packBase = './';
+let frames = 0;
+let running = false;
+// Set once Emscripten's runtime is initialised. See the guard in `self.onmessage` for why input has to
+// wait for it.
+let ready = false;
+
+function describe(error) {
+  if (error === null) return 'null';
+  if (error === undefined) return 'undefined';
+  if (typeof error === 'string') return error;
+  if (error.message) return error.message;
+  if (error.name) return error.name;
+  try { return JSON.stringify(error); } catch (e) { return String(error); }
+}
+
+function say(text) {
+  self.postMessage({ type: 'log', text: String(text) });
+}
+
+// What the page should be told about, shared by both output streams. `draw[` carries each layer's
+// resolved rect, which is the only way to see where a layer was actually drawn over time — the tween
+// log says what the engine intended, not what came out. `lyprop`/`lyc` are what set a layer up in the
+// first place, so they are what explains a layer whose *size* (not position) is wrong.
+//
+// `bgchain` is deliberately NOT here. It is a per-frame probe, and because it changes on every frame of
+// a pan it filled the page's whole ordered buffer and evicted exactly the `lyprop` lines it was meant to
+// be read alongside. A probe that runs every frame must not share a transport with the events being
+// correlated against it.
+// `trans`/`wait`/`anime` are here because the 320 ms between the pan being set up and the texture being
+// swapped to the 1x variant is unaccounted for, and a cross-fade is exactly what would live there. A
+// gap in a trace is a gap in the evidence, not an absence of events.
+// `asb:` lines carry the script flow (which label is running, where a call returns). The engine's .asb
+// runner is re-entrant across files, so "two labels interleaved" is a real way for the tag order to
+// differ from the script's — and the trace has to show the flow, not just the tags, to see it.
+const MIRROR = /ERROR|WARN|Aborted|abort|assert|exception|unreachable|lytween |draw\[|lyprop |lyc |trans |wait |anime |asb: |\biet\b/i;
+
+// The engine's frame budget, matching the Android host.
+//
+// `system.ini` declares `FPS = 60`, and the Android host paces its engine thread to one frame per
+// ~16 ms — it sleeps 16 ms whenever a swap did not already block on vsync. Driving the tick from
+// `requestAnimationFrame` alone instead runs at the display's refresh rate, which here measured
+// ~160 Hz. That is not a cosmetic difference: the script runner executes at most **four script lines
+// per frame**, so a 2.7x faster tick advances the script against the animation clock 2.7x faster, which
+// changes how a scene's tag lines interleave with a tween that was just started. The frames a tween
+// spends "starting" are exactly where a wrong-looking start position shows up.
+const FRAME_MS = 1000 / 60;
+let last_frame = 0;
+
+function loop(now) {
+  if (!running) return;
+  // Scheduled first so every exit path keeps the loop alive.
+  requestAnimationFrame(loop);
+  if (typeof now === 'number' && now - last_frame < FRAME_MS - 0.5) return;
+  if (typeof now === 'number') last_frame = now;
+  // The call is wrapped rather than left to the promise chain, because a wasm trap inside an exported
+  // function throws **synchronously**: `_artc_web_frame()` raises before `Promise.resolve` is ever
+  // called, so the throw leaves `loop()` entirely and surfaces as a worker-level
+  // `Uncaught RuntimeError: Aborted()` with no frame and no context. Catching here keeps the failing
+  // frame's stack and reports it through the same channel as every other message.
+  let pending;
+  try {
+    pending = Promise.resolve(self.Module._artc_web_frame());
+  } catch (error) {
+    running = false;
+    say('frame ' + frames + ' threw: ' + describe(error));
+    if (error && error.stack) say(String(error.stack));
+    console.error('[artc] frame threw synchronously', error);
+    return;
+  }
+  pending.then(function () {
+    frames += 1;
+    // Continuation is decided by `exit_requested`, never by the export's return value: an instrumented
+    // export does not return the function's value, and switching on it once stopped the loop after a
+    // single frame — a black canvas that reads exactly like a renderer fault.
+    if (self.Module._artc_web_exit_requested()) {
+      running = false;
+      say('frame loop stopped at frame ' + frames + ' (engine requested exit)');
+    }
+  }, function (error) {
+    running = false;
+    say('frame failed: ' + describe(error));
+    if (error && error.stack) say(String(error.stack));
+    console.error('[artc] frame failed', error);
+  });
+}
+
+self.onmessage = function (event) {
+  const data = event.data || {};
+
+  // Input is dropped until the runtime is initialised.
+  //
