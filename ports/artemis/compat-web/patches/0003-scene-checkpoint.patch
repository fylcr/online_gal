+namespace {
+bool SceneTag(const std::string& name) {
+    return name=="lyc"||name=="lyprop"||name=="lyevent"||name=="lytween"||name=="anime";
+}
+}
+bool EncodeSceneCommands(const std::vector<SceneCommand>& commands,std::vector<uint8_t>& out) {
+    if(commands.size()>1024)return false;
+    std::vector<uint8_t> bytes={'A','R','C','L'};
+    auto put=[&](uint32_t n){for(int i=0;i<4;++i)bytes.push_back(uint8_t(n>>(i*8)));};
+    put(1);put(uint32_t(commands.size()));
+    auto putstr=[&](const std::string& s)->bool {
+        if(s.size()>64*1024 || bytes.size()+s.size()+8>max_bytes)return false;
+        put(uint32_t(s.size()));bytes.insert(bytes.end(),s.begin(),s.end());return true;
+    };
+    for(const auto& c:commands) {
+        if(!SceneTag(c.name) || c.attrs.size()>64 || !putstr(c.name))return false;
+        put(uint32_t(c.attrs.size()));
+        for(const auto& a:c.attrs) if(!putstr(a.first) || !putstr(a.second))return false;
+    }
+    put(crc32(0,bytes.data(),bytes.size()));
+    out.insert(out.end(),bytes.begin(),bytes.end());return true;
+}
+size_t SceneTrailerSize(const std::vector<uint8_t>& bytes) {
+    if(bytes.size()<20)return 0;
+    const size_t pos=bytes.size()-4;
+    uint32_t stored=0;for(int i=0;i<4;++i)stored|=uint32_t(bytes[pos+i])<<(i*8);
+    for(size_t at=0;at+16<=pos;++at) {
+        if(std::memcmp(bytes.data()+at,"ARCL",4))continue;
+        if(crc32(0,bytes.data()+at,pos-at)==stored)return bytes.size()-at;
+    }
+    return 0;
+}
+bool DecodeSceneCommands(const std::vector<uint8_t>& bytes,size_t at,std::vector<SceneCommand>& out,size_t& end) {
+    if(at>bytes.size() || bytes.size()-at<16 || bytes.size()>max_bytes)return false;
+    if(std::string(bytes.begin()+at,bytes.begin()+at+4)!="ARCL")return false;
+    size_t pos=at+4;bool valid=true;
+    auto get=[&]()->uint32_t {
+        if(bytes.size()-pos<4){valid=false;return 0;}
+        uint32_t n=0;for(int i=0;i<4;++i)n|=uint32_t(bytes[pos++])<<(i*8);return n;
+    };
+    if(get()!=1)return false;
+    const auto count=get();if(!valid || count>1024)return false;
+    auto str=[&]()->std::string {
+        const auto n=get();if(!valid || n>64*1024 || n>bytes.size()-pos){valid=false;return {};}
+        std::string s(reinterpret_cast<const char*>(bytes.data()+pos),n);pos+=n;return s;
+    };
+    std::vector<SceneCommand> next;
+    for(uint32_t i=0;i<count;++i) {
+        SceneCommand c;c.name=str();const auto n=get();
+        if(!valid || !SceneTag(c.name) || n>64)return false;
+        for(uint32_t j=0;j<n;++j){auto k=str(),v=str();if(!valid || !c.attrs.emplace(std::move(k),std::move(v)).second)return false;}
+        next.push_back(std::move(c));
+    }
+    const auto body=pos;const auto expect=get();
+    if(!valid || crc32(0,bytes.data()+at,body-at)!=expect)return false;
+    out=std::move(next);end=pos;return true;
+}
 }
